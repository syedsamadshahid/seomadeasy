# ─────────────────────────────────────────────────────────────
# Vantage — environment variables
# Copy to .env (gitignored) and fill in real values.
# Phase 1 needs only the Database + Cache + App blocks to run.
# ─────────────────────────────────────────────────────────────

# ── Phase 1: Database (Neon Postgres) ──
# Pooled connection (host contains "-pooler") — used at runtime by the app.
DATABASE_URL=
# Direct connection (no "-pooler") — used by Prisma Migrate / introspection.
DIRECT_URL=

# ── Phase 1: Cache (Upstash Redis, REST) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Phase 1: App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# DEV_USER_ID — removed in Phase 7 (real Firebase Auth replaced the hardcoded dev user)

# ── Phase 2: Job pipeline (Inngest) ──
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Phase 2: Vendor data APIs ──
# DataForSEO uses HTTP Basic auth.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GOOGLE_PAGESPEED_API_KEY=

# ── Phase 3–4: LLMs (GEO probes + content generation) ──
GEMINI_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# ── Phase 5–6: Email + GSC OAuth + token encryption ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=reports@yourdomain.com
# 32-byte key (hex/base64) for AES-256-GCM token encryption (lib/crypto).
TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ── Phase 7: Auth (Firebase) ──
# Server (Admin SDK)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Client (public config — safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Phase 8: Payments (Stripe) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price IDs — copy from Stripe Dashboard after creating Pro/Agency products
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# ── TESTING ONLY: DeepSeek LLM override ────────────────────────────────────
# WARNING: DeepSeek is explicitly banned for production (US SMB trust/compliance).
# Set USE_DEEPSEEK_TEST=true ONLY for local pipeline testing while real LLM keys
# (GEMINI_API_KEY, OPENAI_API_KEY, PERPLEXITY_API_KEY, ANTHROPIC_API_KEY) are not yet set.
# With this flag on, ALL LLM calls (GEO probes, parsing, content) route to DeepSeek.
# GEO scores produced under this flag are SYNTHETIC — DeepSeek is not a real visibility surface.
# Remove both lines before committing or deploying. See CLAUDE.md for the override note.
# DEEPSEEK_API_KEY=
# USE_DEEPSEEK_TEST=true
